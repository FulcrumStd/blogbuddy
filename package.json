{
  "name": "blogbuddy",
  "displayName": "Blog Buddy",
  "description": "Your AI-powered blog writing sidekick that makes Markdown magic happen!",
  "version": "0.0.19",
  "icon": "images/icon.png",
  "publisher": "FulcrumStudio",
  "repository": {
    "url": "https://github.com/FulcrumStd/blogbuddy.git",
    "type": "git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "blogbuddy.bb",
        "title": "BlogBuddy: Hi BB"
      },
      {
        "command": "blogbuddy.selectModel",
        "title": "BlogBuddy: Select Model"
      },
      {
        "command": "blogbuddy.showDiagnostics",
        "title": "BlogBuddy: Show Config Diagnostics"
      },
      {
        "command": "blogbuddy.openEditor",
        "title": "BlogBuddy: Open BB Editor",
        "icon": {
          "light": "images/icon.png",
          "dark": "images/icon.png"
        }
      },
      {
        "command": "blogbuddy.openSource",
        "title": "BlogBuddy: Reopen as Markdown Source",
        "icon": "$(code)"
      },
      {
        "command": "blogbuddy.createReaderTemplate",
        "title": "BlogBuddy: Create .bbreader.md Template"
      },
      {
        "command": "blogbuddy.showUsageStats",
        "title": "BlogBuddy: Show Usage Statistics"
      },
      {
        "command": "blogbuddy.resetUsageStats",
        "title": "BlogBuddy: Reset Usage Statistics"
      },
      {
        "command": "blogbuddy.refreshPricing",
        "title": "BlogBuddy: Refresh Pricing Data"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "blogbuddy.openEditor",
          "when": "resourceExtname == .md && resourceScheme == file",
          "group": "navigation@-10"
        },
        {
          "command": "blogbuddy.openSource",
          "when": "activeWebviewPanelId == 'blogbuddy.editor'",
          "group": "navigation@-10"
        }
      ]
    },
    "keybindings": [
      {
        "command": "blogbuddy.bb",
        "key": "ctrl+b ctrl+b",
        "mac": "cmd+b cmd+b",
        "when": "editorTextFocus"
      },
      {
        "command": "blogbuddy.openEditor",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "(filesExplorerFocus && resourceExtname == .md) || editorLangId == markdown"
      },
      {
        "command": "blogbuddy.openSource",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "activeWebviewPanelId == 'blogbuddy.editor'"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Blog Buddy",
      "properties": {
        "blogbuddy.apiKey": {
          "type": "string",
          "default": "",
          "description": "API 密钥，留空时读取环境变量。",
          "order": 1
        },
        "blogbuddy.baseURL": {
          "type": "string",
          "default": "",
          "description": "OpenAI 兼容接口地址，留空使用环境变量或默认地址。",
          "order": 2
        },
        "blogbuddy.model": {
          "type": "string",
          "default": "",
          "description": "用于 AI 请求的模型 ID。",
          "order": 3
        },
        "blogbuddy.assetDir": {
          "type": "string",
          "default": "",
          "description": "上传资源的相对子目录，留空与文档同目录。",
          "order": 4
        },
        "blogbuddy.reader.inlineAssets": {
          "type": "boolean",
          "default": true,
          "description": "导出 HTML 时嵌入本地图片，关闭则保留相对路径。",
          "order": 5
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd out/test/utils/frontmatter.test.js out/test/utils/preserveUnchanged.test.js out/test/utils/MarkdownStatsAnalyzer.test.js out/test/utils/bbCommandRange.test.js out/test/services/EditorDocumentStore.test.js",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@milkdown/kit": "^7.18.0",
    "@types/js-yaml": "^4.0.9",
    "@types/prismjs": "^1.26.6",
    "js-yaml": "^4.1.1",
    "openai": "^5.12.2",
    "prismjs": "^1.30.0"
  }
}
